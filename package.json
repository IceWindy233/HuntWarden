{
  "name": "huntwarden-agent",
  "productName": "HuntWarden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/desktop/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:preload && npm run build:renderer",
    "build:core": "tsc -p tsconfig.json",
    "build:preload": "esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/desktop/preload.cjs",
    "build:renderer": "vite build",
    "dev": "tsx src/index.tsx",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "npm run build:core && npm run build:preload && wait-on tcp:127.0.0.1:5173 && HUNTWARDEN_GUI_DEV_URL=http://127.0.0.1:5173 electron .",
    "dev:gui": "concurrently -k -s first npm:dev:renderer npm:dev:electron",
    "start": "node dist/src/index.js",
    "start:gui": "npm run build && electron .",
    "package:gui": "npm run build && electron-forge package",
    "make:gui": "npm run build && electron-forge make",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:docker": "HUNTWARDEN_DOCKER_TESTS=1 vitest run tests/docker",
    "test:watch": "vitest",
    "model:check": "tsx src/cli/check-model.ts",
    "model:list": "tsx src/cli/list-models.ts",
    "model:smoke": "tsx src/cli/smoke-model.ts",
    "lab:up": "bash labs/lab-up.sh",
    "lab:down": "docker compose -f labs/docker-compose.yml down",
    "probe:build": "bash java/build-probe.sh build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "ink": "7.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-devtools-core": "^7.0.0",
    "ssh2": "1.17.0",
    "typebox": "1.3.7",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "electron": "43.3.0",
    "esbuild": "0.28.1",
    "ink-testing-library": "^4.0.0",
    "jsdom": "30.0.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  }
}
