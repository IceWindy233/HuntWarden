# Built-in providers resolve their own environment variables through pi-ai.
# Only set the provider you use. Never commit a real key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=

# Example variable for model.source=custom. The variable name itself is selected in YAML.
HUNTWARDEN_LLM_API_KEY=
HUNTWARDEN_CONFIG=./config/default.yaml
