{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/gui/contracts.ts", "src/config/schema.ts", "src/domain/types.ts"],
  "exclude": ["dist", "node_modules"]
}
